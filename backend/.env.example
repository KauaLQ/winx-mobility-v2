# Supabase > Project Settings > Database > Connection string (use o Session pooler no Render)
DB_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co

# Assina o token do gestor. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo
GESTOR_EMAIL=gestor@winx.com
GESTOR_SENHA=troque-esta-senha

# true = cria 7 veículos de demonstração se a tabela estiver vazia
SEED_FROTA_DEMO=true
CORS_ORIGINS=["http://localhost:5173","https://seu-app.vercel.app"]